# Copy to secrets.properties (gitignored) and fill in from Google Cloud Console > APIs & Services > Credentials.
# Both clients must be in a project with the Google Drive API enabled and the
# https://www.googleapis.com/auth/drive.appdata scope on the OAuth consent screen.

# "Desktop app" client: browser sign-in with a loopback redirect.
google.desktop.client_id=
google.desktop.client_secret=

# "TVs and Limited Input devices" client: show-a-code sign-in (Steam Deck, fallback).
google.tv.client_id=
google.tv.client_secret=
